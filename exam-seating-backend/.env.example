# Backend Environment Configuration
PORT=5000
NODE_ENV=production

# Option 1 (Render native): Render automatically provides DATABASE_URL
# DATABASE_URL=postgres://user:password@host:port/database

# Option 2: Individual PostgreSQL Connection Parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=exam_seating
# Set DB_SSL=true if connecting to cloud PostgreSQL requiring SSL (e.g. Render, Supabase, Neon)
DB_SSL=true
